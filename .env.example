# Doppler Config (if using Doppler for secrets management)
DOPPLER_CONFIG=<CONFIG>
DOPPLER_ENVIRONMENT=<ENVIRONMENT>
DOPPLER_PROJECT=<PROJECT>

# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY>
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Avatar Generation (optional - choose one)
FAL_KEY=your-fal-ai-key
REPLICATE_API_TOKEN=your-replicate-token

# Product Recommendations via LLM (optional)
OPENAI_API_KEY=your-openai-api-key

# Email Service for Sitter Invites (optional - choose one)
SENDGRID_API_KEY=your-sendgrid-key
RESEND_API_KEY=your-resend-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000